# Clerk application credentials (obtain from the Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Set to the exact public URL of this Next.js deployment
FRONTEND_ORIGIN=http://localhost:3000
# Server-side only: Express API address. MUST NOT be NEXT_PUBLIC_*
BACKEND_INTERNAL_URL=http://localhost:3001
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTERNAL_API_SECRET=replace_with_generated_32_byte_base64_key
